Input: f(x), pop_size, mutation_rate, crossover_rate, max_gen
Output: best_x, best_fitness

Initialize population = random real values between [0,1]  (size = pop_size)
Compute fitness = f(x) for each individual
best_x = individual with highest fitness

for gen = 1 to max_gen:

    # Selection (Tournament)
    parents = select individuals by tournament method

    new_population = empty

    while size(new_population) < pop_size:
        
        select parent1 and parent2 from parents

        # Crossover (linear blend)
        if rand() < crossover_rate:
            alpha = random(0,1)
            child = alpha * parent1 + (1 - alpha) * parent2
        else:
            child = parent1

        # Mutation
        if rand() < mutation_rate:
            child = child + random(-0.1 , +0.1)
            clamp child between [0 , 1]

        add child to new_population

    population = new_population

    evaluate fitness for all individuals
    update best_x if better solution found

return best_x , f(best_x)
